# ---- LLM provider ----
# Use "gemini" for Google AI Studio free-tier testing, or "openai" for OpenAI API.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004

# Local safety cap: one full run normally needs about 4-6 calls.
LLM_MAX_CALLS_PER_RUN=6

# Gemini free-tier guard:
# Keep this true for student/free testing. The app will refuse to run if disabled.
# Also do not enable paid billing / paid tier for the Google AI Studio project.
GEMINI_FREE_TIER_ONLY=true
GOOGLE_API_KEY=""

# OpenAI fallback, only needed if LLM_PROVIDER=openai.
OPENAI_API_KEY=""

# Zoho SMTP (App password)

SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=rxxx@zohomail.com
SMTP_PASSWORD=xxxx
REPORT_EMAIL_TO=xx@zohomail.com

# ---- Option 2: Gmail SMTP ----

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=xxx@gmail.com
SMTP_PASSWORD=xxxx
REPORT_EMAIL_TO=xx@gmail.com

#LangSmith

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls..........
LANGCHAIN_PROJECT=MSBA_AI_Agents_Demo
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
